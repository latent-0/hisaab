# ---------------------------------------------------------------------------
# Hisaab environment configuration
# Copy this file to `.env` and fill in what you have. The app runs fully with
# ZERO keys set, every external dependency has a deterministic mock fallback.
# ---------------------------------------------------------------------------

# Database. SQLite by default for local dev (zero setup).
# For production on Cloud Run, use Postgres, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/hisaab?schema=public"
# and change datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# ---- AI / LLM provider for the 5-agent pipeline -----------------------------
# One of: mock | groq | anthropic | gemini
# "mock" (default) runs a deterministic rule-based engine, no key required.
LLM_PROVIDER="mock"

# Used when LLM_PROVIDER=groq (fast, OpenAI-compatible inference)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Used when LLM_PROVIDER=gemini (uses your Google Cloud credits)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ---- Voice (Indic ASR/TTS + translation) ------------------------------------
# One of: mock | sarvam. "sarvam" powers speech-to-text, text-to-speech, and
# translation of English answers into the merchant's language.
VOICE_PROVIDER="mock"
SARVAM_API_KEY=""
# Optional TTS tuning:
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_SPEAKER="anushka"
# SARVAM_STT_MODEL=""   # leave empty for the API default

# ElevenLabs v3, expressive TTS for spoken answers. Optional: tried first when
# set; Sarvam TTS above is the automatic fallback (unset key, or any failure).
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL="eleven_v3"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
# Lower stability + higher style = more expressive, varied delivery.
ELEVENLABS_STABILITY="0.4"
ELEVENLABS_STYLE="0.65"
ELEVENLABS_SIMILARITY_BOOST="0.8"

# ---- OCR for invoice uploads ------------------------------------------------
# One of: mock | gemini
# "mock" extracts fields heuristically / from any embedded text.
OCR_PROVIDER="mock"

# ---- App ----------------------------------------------------------------
# Secret used to sign the demo session cookie. Change in production.
SESSION_SECRET="dev-hisaab-secret-change-me"
# Where uploaded invoice files are stored: "local" (public/uploads) or "gcs".
FILE_STORE="local"
# GCS bucket if FILE_STORE=gcs
GCS_BUCKET=""

# ---- Automation (n8n / cron) ------------------------------------------------
# Bearer token protecting /api/automation/*. Leave empty to DISABLE those
# endpoints. Set a long random value to enable scheduled sync & reminders.
AUTOMATION_TOKEN=""

# ---- Cognee (AI memory / knowledge graph over GST history) ------------------
# Optional. When set, the voice assistant can answer cross-time questions
# grounded in a knowledge graph of the merchant's invoices/suppliers/returns.
# Get these from platform.cognee.ai → API Keys. Leave empty to disable.
COGNEE_API_BASE=""
COGNEE_API_KEY=""
COGNEE_TENANT_ID=""
COGNEE_USER_ID=""
